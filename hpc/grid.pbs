#!/bin/bash
# One match, in all three ball conditions, through the whole settings grid (possession/grid.py).
# Public, labelled other matches only.
#   qsub -v "ARGS=--sample <folder|npz> --game 1,NAME=metrica_game1" hpc/grid.pbs
#
#PBS -N mtah_grid
#PBS -q cpuq
#PBS -l select=1:ncpus=64:mem=96gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail
mkdir -p "$PBS_O_WORKDIR/calib/grid${GRID:+_$GRID}"
cd "$PBS_O_WORKDIR"
module load "${PY_MODULE:-python/3.14.0-gcc-12.5.0-4km4ttx}"
source "${VENV:-$HOME/mtah-venv}/bin/activate"
for c in rec v59s0 v59s1; do
  case $c in rec) x="";; v59s0) x="--ball-visible 0.59 --seed 0";; v59s1) x="--ball-visible 0.59 --seed 1";; esac
  python -m possession.grid $ARGS $x --grid "${GRID:-v30}" --jobs 64 --out "calib/grid${GRID:+_$GRID}/${NAME}__$c.jsonl"
done
